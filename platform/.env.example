# Copy to .env.local for development. Put real secrets only in local/provider settings.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Required in production: generate at least 32 random bytes; do not reuse the dev secret.
BETTER_AUTH_SECRET=
# Production personal accounts/journals use PostgreSQL; local development defaults to SQLite.
DATABASE_URL=
# Direct connection for explicit migrations; keep secrets only in provider settings.
DATABASE_URL_UNPOOLED=
# One-time controlled deployment migration; leave false for normal builds.
RUN_DATABASE_MIGRATIONS=false
# Restricted to preview deployments with fictional QA records.
RUN_STORAGE_SMOKE_TEST=false
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Enable only on the canonical, reviewed production deployment.
ENABLE_INDEXING=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Requires approved OpenAI partner OAuth credentials and their exact OIDC discovery URL.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_DISCOVERY_URL=

# Email verification and password recovery; use a verified sender domain.
RESEND_API_KEY=
MAIL_FROM=

# Optional public-source explanations. Nothing calls an AI model while disabled.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
